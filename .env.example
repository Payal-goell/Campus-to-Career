# Database configuration (PostgreSQL via Docker or local/cloud instance).
# Vercel cannot use localhost. Set DATABASE_URL in the Vercel project to a hosted
# Postgres URL (Neon, Supabase, or Vercel Postgres), then run prisma db push and seed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_to_career?schema=public"

# Authentication Secrets
JWT_SECRET="campus-to-career-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="campus-to-career-super-secret-refresh-key-change-in-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External API Keys (OpenAI / AI skill gap analyzer)
OPENAI_API_KEY=""

# Hybrid roadmap ML service (FastAPI). Leave empty to use the TypeScript rules fallback.
# Local: http://127.0.0.1:8000   Production: https://your-ml-service.onrender.com
ML_SERVICE_URL=""

# Optional path inside the ML container/process (defaults to ml/artifacts/roadmap_model.joblib)
# ML_MODEL_PATH="/app/artifacts/roadmap_model.joblib"
